# API Credentials Configuration
# Copy this file to .env and insert your personal API keys

# Groq API Key (Get free key from https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here

# OpenRouter API Key (Get key from https://openrouter.ai/keys)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Model Selection
CHATBOT_MODEL=meta-llama/llama-3.2-3b-instruct:free

# Request Timeout (seconds)
REQUEST_TIMEOUT=15

# Environment Configuration for Chatbot Backend
# Copy this file to .env and fill in your credentials

# OpenRouter API Key (Get yours from https://openrouter.ai/keys)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional: Groq API Key (alternative provider for fast testing)
GROQ_API_KEY=your_groq_api_key_here

# Chatbot Model Configuration
# Example OpenRouter models: "openrouter/auto", "meta-llama/llama-3.2-3b-instruct:free", "google/gemini-2.0-flash-exp:free"
CHATBOT_MODEL=meta-llama/llama-3.2-3b-instruct:free

# Network Timeout Settings (in seconds)
REQUEST_TIMEOUT=15
